{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nurturemom-official-approved-plus-preview",
  "main": "worker-plus.js",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
