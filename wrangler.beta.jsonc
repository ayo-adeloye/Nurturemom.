{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nurturemom-beta",
  "main": "worker-plus.js",
  "compatibility_date": "2026-09-17",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./public-beta",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
